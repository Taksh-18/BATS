# The app connects as the limited role bats_app (see sql/roles.sql); schema changes use the owner role.
DATABASE_URL=postgresql+asyncpg://bats_app:change_me@localhost:5432/bats
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
JWT_SECRET=replace_with_output_of__openssl_rand_-hex_32
HMS_API_KEY=replace_with_a_long_random_string
