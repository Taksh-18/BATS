# The app connects as the limited role bats_app (see sql/roles.sql); schema changes use the owner role.
DATABASE_URL=postgresql+asyncpg://bats_app:change_me@localhost:5432/bats
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
JWT_SECRET=replace_with_output_of__openssl_rand_-hex_32
HMS_API_KEY=replace_with_a_long_random_string
# Off by default. Enable ONLY for local demos: the mock HMS has no login, and /docs maps the whole API.
ENABLE_MOCK_HMS=false
ENABLE_DOCS=false
# Set to true when served over HTTPS
ENABLE_HSTS=false
# Number of reverse proxies in front of the app (so rate limits see real client IPs); 0 if none
TRUSTED_PROXY_COUNT=0
# Always start uvicorn with --no-proxy-headers (run.sh does). Uvicorn would otherwise trust
# X-Forwarded-For from localhost on its own and let clients forge their IP past the rate limits.
